# Copy this file to .env before starting the stack. Never upload .env to GitHub or Drive.

# Time zone
TZ=Asia/Kolkata
GENERIC_TIMEZONE=Asia/Kolkata

# Local-only default: no public domain or external webhooks.
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=false

# Pin a tested n8n version after the first successful local install. Leave latest only for initial setup.
N8N_VERSION=latest

# Generate strong values locally; do not reuse these placeholders.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_64_CHAR_RANDOM_KEY

# Keep successful/error execution data for 14 days by default.
EXECUTIONS_DATA_MAX_AGE=336

# For a future public HTTPS domain, set all of these together:
# N8N_HOST=n8n.example.com
# N8N_PROTOCOL=https
# N8N_EDITOR_BASE_URL=https://n8n.example.com
# WEBHOOK_URL=https://n8n.example.com/
# N8N_SECURE_COOKIE=true
