    {
      "id": "6ccabfb4-9240-455e-b597-bbde2394ccc0",
      "name": "Build Job Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const j = $json;\nconst link = (j['Job link'] || '').trim();\nconst details = (j['Job details / paste text'] || '').trim();\nconst note = (j['Source note'] || '').trim();\n\nconst parts = [];\nif (details) parts.push(details);\nif (link) parts.push('Link: ' + link);\nif (note) parts.push('Source note: ' + note);\nconst raw_text = parts.join('\\n');\n\nconst has_content = (details.length > 0 || link.length > 0);\n\nreturn { json: {\n  has_content: has_content,\n  raw_text: raw_text,\n  source: 'manual_form',\n  apply_link: link,\n  source_url: link,\n} };"
      }
    },
