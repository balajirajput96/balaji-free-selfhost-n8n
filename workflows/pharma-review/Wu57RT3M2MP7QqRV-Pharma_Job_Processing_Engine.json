{
  "name": "Pharma Job Processing Engine",
  "nodes": [
    {
      "parameters": {
        "content": "## Job Processing Engine\nCalled by intake channels (RSS, email, form) via Execute Workflow.\nExtracts + scores a job posting, filters to pharma QA roles & 2yr experience band,\ndeduplicates by source_id, and inserts into the pharma_job_tracker Data Table.\nStrict never-invent rule: uncertain contact/date/salary/address stays empty & \"not verified\"."
      },
      "id": "b75fc155-5b44-4f75-8de5-ca6a7621625c",
      "name": "Sticky Note b75fc155",
