      "id": "9e5a6c9f-2dbb-48f1-bffe-13f1d555623f",
      "name": "Extract & Score Job",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let ai = null;\ntry {\n  const raw = $json.output[0].content[0].text;\n  ai = (typeof raw === 'string') ? JSON.parse(raw) : raw;\n} catch (e) { ai = null; }\n\nconst t = $(\"Job Input\").item.json;\n\nfunction slug(v) {\n  return String(v || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');\n}\n\nif (!ai) {\n  return { json: { keep: false, drop_reason: \"ai_parse_failed\" } };\n}\n\nconst relevant = ai.is_pharma_qa_relevant === true && ai.matched_role && ai.matched_role !== \"none\";\nconst effMin = (ai.experience_min === null || ai.experience_min === undefined) ? 0 : Number(ai.experience_min);\nconst effMax = (ai.experience_max === null || ai.experience_max === undefined) ? 999 : Number(ai.experience_max);\nconst expOk = effMin <= 2 && effMax >= 2;\nconst keep = relevant && expOk;\n\nconst ot = ai.opportunity_type || \"unknown\";\nlet priority_rank = 4;\nif (ot === \"walkin\") priority_rank = 1;\nelse if (ot === \"direct\") priority_rank = 2;\nelse if (ot === \"upcoming\") priority_rank = 3;\n\nconst source_id = slug(ai.company_name) + \"|\" + slug(ai.job_title) + \"|\" + slug(ai.location);\n\nconst applyLink = ai.apply_link || t.apply_link || \"\";\n\nreturn { json: {\n  keep: keep,\n  drop_reason: keep ? \"\" : (!relevant ? \"not_relevant\" : \"experience_mismatch\"),\n  source_id: source_id,\n  source: t.source || \"\",\n  company_name: ai.company_name || \"\",\n  job_title: ai.job_title || \"\",\n  department: ai.department || \"\",\n  location: ai.location || \"\",\n  address: ai.address || \"\",\n  walkin_datetime: ai.walkin_datetime || \"\",\n  walkin_venue: ai.walkin_venue || \"\",\n  apply_link: applyLink,\n  contact_email: ai.contact_email || \"\",\n  contact_phone: ai.contact_phone || \"\",\n  contact_whatsapp: ai.contact_whatsapp || \"\",\n  experience_required: ai.experience_required || \"\",\n  salary_ctc: ai.salary_ctc || \"\",\n  company_size_type: ai.company_size_type || \"\",\n  match_score: Number(ai.match_score) || 0,\n  score_breakdown: ai.score_breakdown || \"\",\n  opportunity_type: ot,\n  priority_rank: priority_rank,\n  verification_status: ai.verification_status || \"not verified\",\n  raw_text: t.raw_text || \"\",\n} };"
      },
