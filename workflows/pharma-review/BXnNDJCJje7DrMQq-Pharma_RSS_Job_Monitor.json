      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const j = $json;\nconst title = j.title || '';\nconst content = j.contentSnippet || j.content || j.summary || j['content:encoded'] || '';\nconst link = j.link || j.guid || '';\nconst parts = [];\nif (title) parts.push(title);\nif (content) parts.push(content);\nif (link) parts.push('Link: ' + link);\nconst raw_text = parts.join('\\n');\nreturn { json: {\n  raw_text: raw_text,\n  source: 'google_alerts_rss',\n  apply_link: link,\n  source_url: link,\n} };"
      }
