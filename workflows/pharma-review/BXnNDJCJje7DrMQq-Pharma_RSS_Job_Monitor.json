        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// EDIT THESE: paste your Google Alerts RSS feed URLs here.\n// Create alerts at https://www.google.com/alerts (e.g. \"pharma QA walk-in Vadodara\",\n// \"IPQA officer Ahmedabad\") and choose \"Deliver to: RSS feed\" to get each URL.\nreturn [\n  { json: { url: 'https://REPLACE_WITH_GOOGLE_ALERT_FEED_1' } },\n  { json: { url: 'https://REPLACE_WITH_GOOGLE_ALERT_FEED_2' } },\n];"
