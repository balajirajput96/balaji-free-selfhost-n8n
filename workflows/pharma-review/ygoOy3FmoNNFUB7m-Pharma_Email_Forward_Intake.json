{
  "name": "Pharma Email-Forward Intake",
  "nodes": [
    {
      "parameters": {
        "content": "## Email-Forward Job Intake\nForward any pharma job email to your Gmail with the label \"JobIntake\"\n(or edit the trigger query). Each forwarded email is parsed and sent to the\nPharma Job Processing Engine, which filters, scores, dedups, and stores matches.\nOnly links actually present in the email are captured — nothing is invented."
      },
      "id": "7aeaff29-53f2-42d3-9ba7-0ebecda27ec0",
