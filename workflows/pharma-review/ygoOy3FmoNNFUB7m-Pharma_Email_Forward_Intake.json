    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst subject = j.subject || '';\n// Prefer plain text; fall back to stripping HTML tags.\nlet body = j.text || '';\nif (!body && (j.textAsHtml || j.html)) {\n  body = String(j.textAsHtml || j.html).replace(/<[^>]+>/g, ' ');\n}\nbody = String(body).replace(/\\s+/g, ' ').trim();\n\nconst parts = [];\nif (subject) parts.push('Subject: ' + subject);\nif (body) parts.push(body);\nconst raw_text = parts.join('\\n');\n\n// Capture the first http(s) URL in the body as the apply link. Never invent one.\nlet apply_link = '';\nconst m = body.match(/https?:\\/\\/[^\\s\"\\)<>]+/);\nif (m) apply_link = m[0];\n\nconst has_content = (subject.trim().length > 0 || body.length > 0);\n\nreturn { json: {\n  has_content: has_content,\n  raw_text: raw_text,\n  source: 'email_forward',\n  apply_link: apply_link,\n  source_url: apply_link,\n} };"
      },
